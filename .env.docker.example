# Exemple de configuration Docker locale pour Vite & Gourmand.
# Copiez ce fichier en .env.docker puis remplacez les valeurs fictives
# par vos propres identifiants.
DB_NAME=vite_gourmand
DB_USER=vitegourmand
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me

BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com

APP_URL=http://localhost:8080
CONTACT_RECIPIENT_EMAIL=contact@example.com

MONGODB_URI=mongodb+srv://username:password@cluster/
MONGODB_DATABASE=vite_gourmand
MONGODB_ALLOW_INVALID_CERTIFICATES=false
MONGODB_TLS_CA_FILE=